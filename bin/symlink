#!/usr/bin/env bash

# Sublime Text

repository_dir=$(dirname $(dirname $(cd $(dirname $0); pwd)/$(basename $0)))"/sublime-text";
dir="$repository_dir/User";
packages_dir="$HOME/Library/Application Support/Sublime Text/Packages";

for f in $dir/*; do
	file=$(basename "$f");
	ln -sfhv "$dir/$file" "$packages_dir/User/$file";
done

ln -sfhv "$repository_dir/Copy Filepath With Line Numbers" "$packages_dir/Copy Filepath With Line Numbers";

# Sublime Merge

repository_dir=$(dirname $(dirname $(cd $(dirname $0); pwd)/$(basename $0)))"/sublime-merge";
dir="$repository_dir/User";
packages_dir="$HOME/Library/Application Support/Sublime Merge/Packages";

for f in $dir/*; do
	file=$(basename "$f");
	ln -sfhv "$dir/$file" "$packages_dir/User/$file";
done
